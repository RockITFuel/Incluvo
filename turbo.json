{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["dist/**", ".output/**"]
		},
		"check-types": {
			"dependsOn": ["^check-types"]
		},
		"test": {
			"cache": false,
			// Strict env mode hides undeclared vars from tasks; CI passes the
			// test database this way (test/preload.ts).
			"passThroughEnv": ["TEST_DATABASE_URL", "DATABASE_URL"]
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		}
	}
}
