{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "types": [
      "vite/client",
      "node"
    ],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "customConditions": [
      "browser"
    ]
  },
  "include": [
    "src",
    "vite.config.ts"
  ]
}
